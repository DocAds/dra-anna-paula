{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dra-anna-bomtempo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "36298b1450b647c295a0f06dbee566b5" },
    { "binding": "NEXT_TAG_CACHE_KV", "id": "a7b5ed01378a416e903a5ccddcc21fd3" }
  ],
  "observability": {
    "enabled": true
  }
}
